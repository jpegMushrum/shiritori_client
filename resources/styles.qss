/* === BASE === */
QWidget {
    background-color: #1a1b26; /* глубокий тёмный */
    color: #c0caf5;
    font-family: "Segoe UI", "Noto Sans JP", sans-serif;
    font-size: 12px;
}

/* === LABELS === */
QLabel {
    font-family: "Funnel Display", "Shippori Mincho";
    color: #c0caf5;
}

QLabel#titleLabel {
    font-size: 24px;
    font-weight: bold;
    color: #7aa2f7;
}

QLabel#largeTitle {
    font-size: 28px;
    font-weight: bold;
    color: #7aa2f7;
}

QLabel#subtitle {
    font-size: 18px;
    font-weight: bold;
    color: #7aa2f7;
}

QLabel#errorLabel {
    color: #f7768e;
}

QLabel#infoLabel {
    color: #9aa5ce;
}

/* === BUTTONS (без "нажатия") === */
QPushButton {
    background-color: #2a2f45;
    color: #c0caf5;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton:focus {
    outline: none;
    border: none;
}

QPushButton:hover {
    background-color: #323a5a;
}

/* УБРАЛИ эффект нажатия */
QPushButton:pressed {
    background-color: #2a2f45;
}

QPushButton:disabled {
    background-color: #1f2335;
    color: #565f89;
}

/* === Dialog === */

QLabel#dialogSectionHeader {
    font-size: 13px;
    font-weight: bold;
    color: #7aa2f7;
}

QLabel#dialogContent {
    font-size: 12px;
    color: #c0caf5;
}

QLabel#wordKanji {
    font-size: 28px;
    font-weight: bold;
    color: #e0af68;
}

/* === INPUT === */
QLineEdit {
    background-color: #1f2335;
    border: 1px solid #3b4261;
    border-radius: 6px;
    padding: 6px;
}

QLineEdit:focus {
    border: 1px solid #7aa2f7;
}

/* === LIST === */
QListWidget {
    background-color: #1f2335;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: #3b4261;
}

/* === TABLE === */
QTableWidget {
    background-color: #1f2335;
    border: none;
    gridline-color: #3b4261;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QTableWidget:focus {
    outline: none;
}

QHeaderView::section {
    background-color: #24283b;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #3b4261;
    font-weight: 600;
}

QHeaderView::up-arrow {
    image: url(:/icons/caret-arrow-up.png);
    width: 10px;
    height: 10px;
}

QHeaderView::down-arrow {
    image: url(:/icons/caret-arrow-down.png);
    width: 10px;
    height: 10px;
}

/* === SCROLL === */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #3b4261;
    border-radius: 5px;
}

/* === TOAST === */
ToastWidget {
    border-radius: 10px;
    padding: 10px;
}

ToastWidget#notification {
    background-color: #1a1b26;
    border: 2px solid #7aa2f7;
    border-radius: 10px;
}

ToastWidget#warning {
    background-color: #1a1b26;
    border: 2px solid #e0af68;
    border-radius: 10px;
}

ToastWidget#error {
    background-color: #1a1b26;
    border: 2px solid #f7768e;
    border-radius: 10px;
}

QLabel#toastMessage {
    background: transparent;
    color: #c0caf5;
    font-weight: bold;
}
